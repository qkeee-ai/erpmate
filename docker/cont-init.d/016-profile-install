#!/command/with-contenv sh
# shellcheck shell=sh
# Install the erpnext-hermes profile distribution on first boot; equivalent to:
#   hermes profile install <source> --name <name> --alias
# The profile lives in $HERMES_HOME/profiles/<name> (on the volume), so it
# persists. Later boots skip the install; set HERMES_PROFILE_AUTO_UPDATE=1 to
# run `hermes profile update` each boot instead (user data is preserved).
# Non-fatal.
#
# Source selection (first match wins):
#   HERMES_PROFILE_LOCAL_PATH  local clone mounted into the container; must
#                              contain distribution.yaml at its root
#   HERMES_PROFILE_SOURCE      git URL; empty string skips the install entirely.
#                              docker-compose.yaml always sets this, so the
#                              fallback below only applies to a bare `docker
#                              run`. Keep the two spellings in sync — they
#                              drifted once (this hook still pointed at a repo
#                              that had been renamed), which would have
#                              installed nothing outside compose.
#   HERMES_PROFILE_BRANCH      branch of the git source; empty = the repo's
#                              default branch. Ignored in local mode. Hermes
#                              clones only the default branch, so this hook
#                              shallow-clones the branch into
#                              $HERMES_HOME/.profile-src/<name> and installs or
#                              updates from that tree. If the branch cannot be
#                              fetched, the hook installs/updates nothing (it
#                              never falls back to the default branch).
#
# The configured source wins on update: `hermes profile update` re-pulls the
# source recorded at install time, so before an update this hook rewrites the
# profile's recorded `source:` to the configured one (log line "recorded
# source: <old> -> <new>"). Otherwise a changed HERMES_PROFILE_SOURCE,
# _LOCAL_PATH or _BRANCH would be silently ignored.
#
# Private git URL auth (never written to disk or into the URL):
#   HTTPS: HERMES_PROFILE_GIT_TOKEN or HERMES_PROFILE_GIT_TOKEN_FILE
#          (sent as an Authorization header for the source's host only)
#   SSH:   HERMES_PROFILE_SSH_KEY_FILE with a git@host:org/repo source

HERMES_HOME="${HERMES_HOME:-/opt/data}"
NAME="${HERMES_PROFILE_NAME:-}"   # empty => derived from the source's folder/repo name below

run() { HOME=/opt/data HERMES_HOME="$HERMES_HOME" s6-setuidgid hermes "$@"; }

# Never let git block on a credential prompt during boot.
export GIT_TERMINAL_PROMPT=0

if [ -n "${HERMES_PROFILE_LOCAL_PATH:-}" ]; then
    SOURCE="$HERMES_PROFILE_LOCAL_PATH"
    if [ ! -f "$SOURCE/distribution.yaml" ]; then
        echo "[profile-install] WARNING: $SOURCE/distribution.yaml not found; is the clone mounted? skipping" >&2
        exit 0
    fi
    MODE=local
else
    SOURCE="${HERMES_PROFILE_SOURCE-https://github.com/qkeee-ai/erpmate.git}"
    [ -n "$SOURCE" ] || { echo "[profile-install] no source configured; skipping"; exit 0; }
    MODE=git

    case "$SOURCE" in
        http://*|https://*|git@*|ssh://*) ;;
        *) SOURCE="https://$SOURCE" ;;   # bare github.com/org/repo, as hermes accepts
    esac

    # HTTPS token -> per-process git config via env (no file, no URL rewrite,
    # so the token cannot show up in git's error messages).
    TOKEN="${HERMES_PROFILE_GIT_TOKEN:-}"
    if [ -z "$TOKEN" ] && [ -n "${HERMES_PROFILE_GIT_TOKEN_FILE:-}" ]; then
        TOKEN="$(cat "$HERMES_PROFILE_GIT_TOKEN_FILE" 2>/dev/null)" \
            || echo "[profile-install] WARNING: cannot read HERMES_PROFILE_GIT_TOKEN_FILE" >&2
    fi
    case "$SOURCE" in
        http://*|https://*)
            if [ -n "$TOKEN" ]; then
                host="$(printf '%s' "$SOURCE" | sed -E 's#^https?://([^/]+)/.*#\1#')"
                basic="$(printf 'x-access-token:%s' "$TOKEN" | base64 | tr -d '\n')"
                export GIT_CONFIG_COUNT=1
                export GIT_CONFIG_KEY_0="http.https://${host}/.extraheader"
                export GIT_CONFIG_VALUE_0="Authorization: Basic ${basic}"
            fi ;;
        git@*|ssh://*)
            if [ -n "${HERMES_PROFILE_SSH_KEY_FILE:-}" ]; then
                export GIT_SSH_COMMAND="ssh -i $HERMES_PROFILE_SSH_KEY_FILE -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/tmp/jev-known-hosts"
            fi ;;
    esac
    unset TOKEN basic
fi

# Default profile name = last path segment of the source (the repo/folder name):
#   https://github.com/qkeee-ai/erpmate.git -> erpmate,  /opt/erpmate -> erpmate
# normalised to a safe profile name (lowercase, [a-z0-9_-]).
if [ -z "$NAME" ]; then
    NAME="$(basename "${SOURCE%/}" .git | tr 'A-Z' 'a-z' | sed -E 's/[^a-z0-9_-]+/-/g; s/^-+//; s/-+$//')"
fi
[ -n "$NAME" ] || { echo "[profile-install] WARNING: cannot derive a profile name from $SOURCE; set HERMES_PROFILE_NAME" >&2; exit 0; }
# Hand the resolved name to later hooks (/run is tmpfs, so rewritten every boot).
printf '%s' "$NAME" > /run/hermes-profile-name

BRANCH="${HERMES_PROFILE_BRANCH:-}"
if [ -n "$BRANCH" ] && [ "$MODE" = local ]; then
    echo "[profile-install] HERMES_PROFILE_BRANCH=$BRANCH ignored: HERMES_PROFILE_LOCAL_PATH is set" >&2
    BRANCH=""
fi
INSTALL_SOURCE="$SOURCE"   # what hermes installs/updates from; fetch_branch changes it
BRANCH_DIR="$HERMES_HOME/.profile-src/$NAME"

# Shallow-clone $BRANCH of $SOURCE into $BRANCH_DIR (no .git: Hermes copies a
# local source as it is). Auth env (GIT_CONFIG_* / GIT_SSH_COMMAND) was
# exported above.
fetch_branch() {
    _tmp="$BRANCH_DIR.tmp"
    rm -rf "$_tmp"
    mkdir -p "$(dirname "$BRANCH_DIR")"
    if ! git clone --depth 1 --single-branch --branch "$BRANCH" --quiet "$SOURCE" "$_tmp"; then
        rm -rf "$_tmp"
        echo "[profile-install] WARNING: cannot fetch branch $BRANCH of $SOURCE; installing/updating nothing" >&2
        return 1
    fi
    echo "[profile-install] $SOURCE branch $BRANCH at $(git -C "$_tmp" rev-parse --short HEAD)"
    rm -rf "$_tmp/.git" "$BRANCH_DIR"
    mv "$_tmp" "$BRANCH_DIR"
    chown -R hermes:hermes "$BRANCH_DIR" 2>/dev/null || true
    INSTALL_SOURCE="$BRANCH_DIR"
}

# Make the profile's recorded source the configured one (see the header).
point_source() {
    _mf="$HERMES_HOME/profiles/$NAME/distribution.yaml"
    [ -f "$_mf" ] || return 0
    _old="$(sed -n 's/^source:[[:space:]]*//p' "$_mf" | head -n 1 | sed -e "s/^[\"']//" -e "s/[\"']\$//")"
    [ "$_old" = "$INSTALL_SOURCE" ] && return 0
    if grep -q '^source:' "$_mf"; then
        sed -i "s#^source:.*#source: $INSTALL_SOURCE#" "$_mf"
    else
        printf 'source: %s\n' "$INSTALL_SOURCE" >> "$_mf"
    fi
    chown hermes:hermes "$_mf" 2>/dev/null || true
    echo "[profile-install] recorded source: ${_old:-none} -> $INSTALL_SOURCE"
}

# Record which skills the DISTRIBUTION owns, as paths relative to <root>/skills.
# 0197-skills-lockdown needs this to tell a distribution skill apart from a
# bundled skill seeded into the same tree: it cannot infer the difference from
# the tree alone, and the bundled manifest baselines (and would therefore let
# the lockdown delete) any distribution skill that happens to be byte-identical
# to its bundled namesake.
#
# Derived from a tree that holds ONLY the distribution payload. A freshly
# installed profile IS such a tree; an already-seeded one is not, so there the
# inventory is read back from the source instead — the mounted clone in local
# mode, or a blobless shallow clone in git mode (tree listing only, no file
# contents). That keeps an existing profile self-healing: the common case is a
# profile installed on an earlier boot, which otherwise never gets a record and
# leaves 0197 unable to prune anything.

RECORD="$HERMES_HOME/profiles/$NAME/.distribution-skills"

install_skill_record() {  # relative skill dir paths on stdin
    sort -u > "$RECORD.tmp" || { rm -f "$RECORD.tmp"; return 1; }
    if [ ! -s "$RECORD.tmp" ]; then
        rm -f "$RECORD.tmp"
        return 1
    fi
    mv "$RECORD.tmp" "$RECORD"
    chown hermes:hermes "$RECORD" 2>/dev/null || true
    echo "[profile-install] recorded $(wc -l < "$RECORD" | tr -d ' ') distribution skill(s) in $RECORD"
}

list_tree_skills() {  # $1 = root containing skills/
    [ -d "$1/skills" ] || return 0
    find "$1/skills" -name SKILL.md -type f 2>/dev/null \
        | sed -e "s|^$1/skills/||" -e 's|/SKILL\.md$||'
}

# Tree listing only: --filter=blob:none --no-checkout fetches no file contents,
# so this costs one small request even on a large repo. Auth env (GIT_CONFIG_*
# / GIT_SSH_COMMAND) was already exported above for git sources.
list_git_skills() {  # $1 = git source; reads $BRANCH
    _t="$(mktemp -d 2>/dev/null)" || return 1
    if [ -n "$BRANCH" ]; then set -- "$1" --branch "$BRANCH"; fi
    if git clone --depth 1 --filter=blob:none --no-checkout --quiet "$@" "$_t/src" 2>/dev/null; then
        git -C "$_t/src" ls-tree -r --name-only HEAD \
            | sed -n 's|^skills/\(.*\)/SKILL\.md$|\1|p'
        rm -rf "$_t"
        return 0
    fi
    rm -rf "$_t"
    return 1
}

# Rebuild the record from whatever view of the distribution we can still reach.
record_from_source() {
    if [ -d "$INSTALL_SOURCE" ]; then   # local mode, or a fetched branch
        list_tree_skills "$INSTALL_SOURCE" | install_skill_record && return 0
    else
        list_git_skills "$SOURCE" | install_skill_record && return 0
    fi
    echo "[profile-install] WARNING: could not read the distribution's skill list from" >&2
    echo "[profile-install]   $SOURCE — 0197-skills-lockdown will denylist but not prune." >&2
    return 1
}

if [ -d "$HERMES_HOME/profiles/$NAME" ]; then
    if [ "${HERMES_PROFILE_AUTO_UPDATE:-0}" = "1" ]; then
        if [ -n "$BRANCH" ]; then fetch_branch || exit 0; fi
        point_source
        if run hermes profile update "$NAME" --yes; then
            echo "[profile-install] $NAME updated"
            record_from_source   # the update may have changed the skill set
        else
            echo "[profile-install] WARNING: update of $NAME failed; continuing" >&2
        fi
    else
        echo "[profile-install] $NAME already installed"
        # Backfill for a profile installed before this hook existed. Skipped once
        # present, so a boot with no network keeps working.
        [ -s "$RECORD" ] || record_from_source
    fi
    exit 0
fi

if [ -n "$BRANCH" ]; then fetch_branch || exit 0; fi
if run hermes profile install "$INSTALL_SOURCE" --name "$NAME" --alias --yes; then
    echo "[profile-install] $NAME installed from $MODE source $SOURCE${BRANCH:+ (branch $BRANCH)}"
    # The freshly installed profile tree is exactly the distribution payload.
    list_tree_skills "$HERMES_HOME/profiles/$NAME" | install_skill_record \
        || echo "[profile-install] WARNING: no skills found in the installed profile" >&2
else
    echo "[profile-install] WARNING: install of $NAME from $INSTALL_SOURCE failed; continuing" >&2
fi
exit 0
