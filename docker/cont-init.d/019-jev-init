#!/command/with-contenv sh
# shellcheck shell=sh
# First-boot jev initialisation, automating the manual steps:
#   jev models suggest --write   -> draft <profile>/jev/routing.json (once)
#   jev doctor                   -> validate; exit 0 == API key present
#   /jev routing on|shadow       -> write <profile>/jev/state.json
# Runs after 017-jev-skills (jev installed) and 016-profile-install (profile exists).
#
# API key: provide TYPESAFE_API_KEY in the container env. jev reads it before the
# OS secret store, so `jev setup-key` is not needed. Without a key, routing.json
# is still drafted but routing stays off; the next boot enables it once the key
# is present.
#
#   JEV_INIT_ENABLE=0          skip this hook
#   JEV_INIT_PROFILES          space-separated profiles ("default" = $HERMES_HOME);
#                              default: $HERMES_PROFILE_NAME
#   JEV_ROUTING_MODE           on | shadow | off   (default: on)
#   JEV_SKILLS_MODE            on | off            (default: on) — jev-driven
#                              skill selection (`/jev skills`); no shadow rung
#
# Idempotent: `models suggest --write` overwrites routing.json, so it runs once
# per profile (marker file); a routing mode already in state.json (e.g. the
# operator ran `/jev routing off`) is never overridden. Non-fatal.

[ "${JEV_INIT_ENABLE:-1}" = "0" ] && { echo "[jev-init] disabled via JEV_INIT_ENABLE=0"; exit 0; }

HERMES_HOME="${HERMES_HOME:-/opt/data}"
MODE="${JEV_ROUTING_MODE:-on}"
SKILLS="${JEV_SKILLS_MODE:-on}"
# Default target: the profile resolved by 016-profile-install.
TARGETS="${JEV_INIT_PROFILES:-${HERMES_PROFILE_NAME:-$(cat /run/hermes-profile-name 2>/dev/null)}}"
[ -n "$TARGETS" ] || { echo "[jev-init] no target profile (016 skipped?); set JEV_INIT_PROFILES" >&2; exit 0; }
JEV=/opt/jev-skills/bin/jev
[ -x "$JEV" ] || JEV=jev

case "$MODE" in on|shadow|off) ;; *) echo "[jev-init] WARNING: bad JEV_ROUTING_MODE=$MODE; using shadow" >&2; MODE=shadow ;; esac
# jev's own `/jev skills` accepts on|off only — no shadow rung.
case "$SKILLS" in on|off) ;; *) echo "[jev-init] WARNING: bad JEV_SKILLS_MODE=$SKILLS; using off" >&2; SKILLS=off ;; esac

# jev resolves the profile from HERMES_HOME (profiles/<name> => that profile).
jrun() { HOME=/opt/data HERMES_HOME="$H" s6-setuidgid hermes "$@"; }

for name in $TARGETS; do
    if [ "$name" = default ]; then H="$HERMES_HOME"; else H="$HERMES_HOME/profiles/$name"; fi
    tag="[jev-init:$name]"
    [ -d "$H" ] || { echo "$tag WARNING: $H missing (profile not installed?); skipping" >&2; continue; }
    jrun mkdir -p "$H/jev" || continue

    marker="$H/jev/.docker-init-done"

    # Seed a curated routing.json if the profile has none. Never overwrites an
    # existing one. Source precedence: JEV_ROUTING_FILE (mounted from the host),
    # then the default baked into the image.
    # Key state decides the ORDER of the two sources below, so resolve it first.
    # doctor exits 0 iff a key is present; routing warnings do not fail it.
    if doc="$(jrun "$JEV" doctor 2>&1)"; then
        key_present=1
        echo "$tag doctor ok: $doc"
    else
        key_present=0
        echo "$tag WARNING: doctor failed (no jev key stored?); see 'jev setup-key': $doc" >&2
    fi

    seeded_marker="$H/jev/.routing-from-defaults"

    # Source precedence: the curated file (JEV_ROUTING_FILE, else the baked
    # default) WINS, and `models suggest --write` is the fallback for when there
    # is no curated source at all.
    #
    # Rationale: suggest optimises purely for catalog price. It cannot know that
    # vision turns here are ERPNext document extraction, or that the hard tier
    # should lead a frontier model. The curated pools encode that, and they are
    # validated against the catalog (monotonic price per specialty, no dead
    # specialty cells, no blind model in a vision pool). Flip the order with
    # JEV_ROUTING_PREFER_SUGGEST=1 when you would rather have price-optimal
    # pools chosen from whatever the catalog holds today.
    #
    # The marker records "this routing.json came from our defaults, not from the
    # operator", so a later boot may regenerate it; a routing.json with no marker
    # was authored in the volume and is never overwritten.
    seed_curated() {
        src=""
        if [ -n "${JEV_ROUTING_FILE:-}" ]; then
            if [ -f "$JEV_ROUTING_FILE" ]; then src="$JEV_ROUTING_FILE"
            else echo "$tag WARNING: JEV_ROUTING_FILE=$JEV_ROUTING_FILE not found; trying baked default" >&2; fi
        fi
        [ -z "$src" ] && [ -f /opt/defaults/jev/routing.json ] && src=/opt/defaults/jev/routing.json
        [ -n "$src" ] || return 1
        if ! python3 -m json.tool "$src" >/dev/null 2>&1; then
            echo "$tag WARNING: $src is not valid JSON; not seeding" >&2
            return 1
        fi
        jrun cp "$src" "$H/jev/routing.json" || return 1
        jrun touch "$seeded_marker"
        echo "$tag seeded routing.json from $src"
    }

    suggest() {
        [ "$key_present" = 1 ] || { echo "$tag models suggest needs a jev key; skipped" >&2; return 1; }
        if out="$(jrun "$JEV" models suggest --write 2>&1)"; then
            echo "$tag models suggest: $out"
            jrun touch "$seeded_marker" "$marker"
            return 0
        fi
        echo "$tag WARNING: models suggest --write failed (empty catalog / network?): $out" >&2
        return 1
    }

    prefer_suggest=0
    case "${JEV_ROUTING_PREFER_SUGGEST:-0}" in 1|true|TRUE|True|yes|YES|Yes) prefer_suggest=1 ;; esac

    if [ ! -e "$H/jev/routing.json" ]; then
        if [ "$prefer_suggest" = 1 ]; then
            suggest || seed_curated || echo "$tag no routing.json and no source for one" >&2
        else
            seed_curated || suggest || echo "$tag no routing.json and no source for one" >&2
        fi
    elif [ -e "$seeded_marker" ] && [ "$prefer_suggest" = 1 ]; then
        # The file on disk came from our defaults, not the operator, and the
        # operator has asked for catalog-chosen pools: regenerate.
        echo "$tag regenerating routing.json from the live model catalog"
        suggest || echo "$tag keeping the seeded routing.json" >&2
    fi

    # Equivalent of `/jev routing $MODE` + `/jev skills $SKILLS` on a fresh
    # profile. Every jev toggle defaults to OFF, so without this a new profile
    # has pools configured and a key present and still routes nothing until
    # someone types the slash commands by hand.
    #
    # Written REGARDLESS of key presence (this used to `continue` when `jev
    # doctor` failed, which is why the mode was never written on any boot: the
    # key only appears after `jev setup-key`, and nothing re-ran afterwards).
    # Safe because jev fails open, per its README: "No key, timeout, rate limit,
    # malformed reply, low confidence: routing keeps your current model, memory
    # returns the original list, compaction drops nothing, skill selection
    # suggests nothing". So routing=on with no key is a no-op that becomes live
    # the moment a key is stored — no restart, no second manual step.
    #
    # An existing value for a toggle is never overridden: `/jev routing shadow`
    # typed by an operator survives every later boot.
    jrun python3 - "$H/jev/state.json" "routing=$MODE" "skills=$SKILLS" <<'PY'
import json, sys

path, pairs = sys.argv[1], [a.split("=", 1) for a in sys.argv[2:]]
try:
    with open(path) as f:
        state = json.load(f)
except FileNotFoundError:
    state = {}
except ValueError:
    print("state.json unparsable; leaving it alone")
    sys.exit(0)
if not isinstance(state, dict):
    print("state.json is not an object; leaving it alone")
    sys.exit(0)

set_, kept = [], []
for key, value in pairs:
    if not value:
        continue
    if key in state:
        kept.append("%s=%r" % (key, state[key]))
    else:
        state[key] = value
        set_.append("%s=%r" % (key, value))
if set_:
    with open(path, "w") as f:
        json.dump(state, f, indent=2)
print("; ".join(filter(None, [
    ("set " + ", ".join(set_)) if set_ else "",
    ("left alone " + ", ".join(kept)) if kept else "",
    "nothing to do" if not set_ and not kept else "",
])))
PY

    # Report what jev actually believes, so a store-format change upstream shows
    # up here instead of silently no-opping. jev 0.22 added toggles beyond
    # `routing` (skills/notice/screen/gate/...); if this disagrees with the
    # values above, the toggles have moved and this hook needs updating.
    if doc="$(jrun "$JEV" doctor 2>&1)"; then
        echo "$tag doctor after init: $doc"
    fi
done
exit 0
