# Copy to .env (git-ignored) and edit:  cp env.example .env
# docker compose reads .env automatically. Values shown are the defaults used
# by docker-compose.yaml when a variable is unset/empty.

# ---------------------------------------------------------------------------
# Build args (image build only: `docker compose build`)
#
# Both default to a MOVING ref, so a rebuild can change agent behaviour with no
# diff in this repo. It has happened twice: jev 0.21.0 -> 0.22.1 moved its 11
# jev-* skills into plugin tools (they vanished from `hermes skills list` with no
# error), and added five toggles beyond `routing` that 019-jev-init did not set,
# leaving jev-driven skill selection off until it was turned on by hand.
#
# 0156-component-versions detects this: it records each component's resolved SHA
# on the volume and shouts when one changes between boots. Pin instead for
# reproducible builds — check what tags exist first:
#   git ls-remote --tags https://github.com/kerpopule/hermes-jev-skills
#   git ls-remote --tags https://github.com/stephenschoettler/hermes-lcm
# then e.g. JEV_REF=v0.22.1 (jev reports its own version via `jev doctor`).
# ---------------------------------------------------------------------------
# hermes-jev-skills ref — tag, branch or commit SHA
JEV_REF=main
# hermes-lcm ref — tag, branch or commit SHA
LCM_REF=main
# 0 = do not compare component versions against the last boot (no drift warning)
HERMES_VERSION_CHECK=1

# ---------------------------------------------------------------------------
# Container name. Precedence: HERMES_CONTAINER_NAME, else HERMES_PROFILE_NAME
# (below), else COMPOSE_PROJECT_NAME (compose's own default: this folder's
# name, lowercased/sanitized). Leave both empty to just get the folder name.
# ---------------------------------------------------------------------------
HERMES_CONTAINER_NAME=

# ---------------------------------------------------------------------------
# Volume mapping (host side)
# Both are bind-mount sources in docker-compose.yaml. One compose file serves
# many agent profiles by pointing these at per-profile host directories.
#   HERMES_DATA_DIR -> /opt/data ($HERMES_HOME): profiles, sessions, skills,
#                      config.yaml, logs. Delete it to reset an agent.
#   HERMES_CWD_DIR  -> $HERMES_CWD: the agent's working directory, i.e. where
#                      the terminal tool starts and where generated files land.
# Relative paths resolve against this compose file's directory.
# ---------------------------------------------------------------------------
HERMES_DATA_DIR=./data/hermes-home
HERMES_CWD_DIR=./data/cwd
# In-container mount point for HERMES_CWD_DIR. Also exported as TERMINAL_CWD,
# which is what the terminal tool reads (config `terminal.cwd` stays unset so
# the env var wins). Leave the default unless it collides with something.
HERMES_CWD=/opt/cwd
# Host uid/gid that owns the two directories above. Files the container writes
# are chowned to these, so a mismatch leaves the cwd mount unwritable by the
# agent (0155-cwd-setup warns, and the agent silently falls back to the nearest
# usable ancestor). On Linux: `id -u` / `id -g`.
HERMES_UID=10000
HERMES_GID=10000

# ---------------------------------------------------------------------------
# Hermes
# ---------------------------------------------------------------------------
# Enable the Hermes web dashboard (container port 9119, host port ephemeral)
HERMES_DASHBOARD=1

# ---------------------------------------------------------------------------
# Dashboard auth (0196-dashboard-auth)
# The dashboard binds 0.0.0.0 inside the container, and a non-loopback bind
# ALWAYS requires a registered auth provider. Without one the service exits,
# s6 restarts it, and the same "Refusing to bind dashboard to 0.0.0.0" refusal
# repeats forever. Set a username AND one of password / password_hash.
#
# These env vars are the reliable surface: they outrank config.yaml and are read
# whichever profile is active. config.yaml is NOT equivalent — the dashboard
# service runs against /opt/data (the default profile), so credentials in the
# custom profile's config.yaml are invisible to it. 0196-dashboard-auth mirrors
# them across for you, but the env vars skip that indirection.
# ---------------------------------------------------------------------------
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
# Plaintext (hashed in memory at startup) — simplest; the password sits in .env.
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
# Preferred for production: precompute the hash so no plaintext is at rest.
#   docker compose exec hermes /opt/hermes/.venv/bin/python -c \
#     "from plugins.dashboard_auth.basic import hash_password; print(hash_password('your-password'))"
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=
# Session-token signing key. Empty = 0196-dashboard-auth generates one and
# persists it at $HERMES_HOME/.dashboard-auth-secret, so logins survive a
# dashboard restart (otherwise the provider mints a random per-process key).
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
# OAuth instead of a password (`hermes dashboard register` for Nous Portal).
HERMES_DASHBOARD_OAUTH_CLIENT_ID=
# Behind a reverse proxy: the external URL clients use. A non-loopback value
# engages the auth gate even when the bind is 127.0.0.1.
HERMES_DASHBOARD_PUBLIC_URL=
# 1 = when the gate will engage with no provider, disable the dashboard for the
# boot and print the fix once, instead of crash-looping. 0 = let it loop.
HERMES_DASHBOARD_AUTOGUARD=1
# 0 = do not copy dashboard.basic_auth from the custom profile's config.yaml
# into /opt/data/config.yaml.
HERMES_DASHBOARD_MIRROR=1

# ---------------------------------------------------------------------------
# Skill lockdown (0197-skills-lockdown)
# A newly launched profile inherits the base image's entire bundled skill
# library (claude-code, manim-video, notion, p5js, xurl, ... ~47 skills) on top
# of the ~25 this distribution ships, all competing for the model's attention
# in every skill-selection pass. The hook restricts the profile to the skills
# in its own skills/ tree: writes the .no-bundled-skills marker (stops future
# seeding), deletes pristine bundled copies, and recomputes skills.disabled for
# anything left over. Runs every boot, so HERMES_PROFILE_AUTO_UPDATE=1
# overwriting config.yaml cannot undo it.
#
# Skills that 017-jev-skills / 018-hermes-lcm link into the profile live under
# the profile's own skills/ tree and stay enabled automatically.
# ---------------------------------------------------------------------------
# 0 = leave the full builtin library enabled
HERMES_SKILLS_LOCKDOWN=1
# Space-separated profiles ("default" = /opt/data). Empty = the profile
# installed by 016-profile-install.
HERMES_SKILLS_LOCKDOWN_PROFILES=
# 0 = only disable bundled skills, keep them on disk (reversible with
# `hermes skills opt-in --sync`). User-modified copies are never deleted.
HERMES_SKILLS_LOCKDOWN_PRUNE=1
# Space/comma-separated extra skill names to keep enabled wherever they live,
# e.g. "github systematic-debugging".
HERMES_SKILLS_KEEP=

# ---------------------------------------------------------------------------
# Profile install on first boot (016-profile-install)
# Source, first match wins:
#   1. HERMES_PROFILE_LOCAL_PATH  (mounted local clone)
#   2. HERMES_PROFILE_SOURCE      (git URL; set to empty to skip the install)
# ---------------------------------------------------------------------------
# Profile name. Empty = last segment of the source (erpmate for the URL below).
HERMES_PROFILE_NAME=
HERMES_PROFILE_SOURCE=https://github.com/qkeee-ai/erpmate.git

# Local clone mode: in-container path of a mounted clone containing
# distribution.yaml, e.g. /opt/erpmate. Also uncomment the matching volume in
# docker-compose.yaml (./:/opt/erpmate:ro).
HERMES_PROFILE_LOCAL_PATH=

# Private repo auth (HTTPS token or SSH key; leave empty for a public repo).
# Token: needs read access to the repo (GitHub PAT / app token).
HERMES_PROFILE_GIT_TOKEN=
# Alternative: path to a file holding the token (e.g. a docker secret).
HERMES_PROFILE_GIT_TOKEN_FILE=
# For git@host:org/repo sources: path to a mounted private key.
HERMES_PROFILE_SSH_KEY_FILE=

# 1 = run `hermes profile update` on every boot (user data is preserved,
# distribution-owned files are overwritten). 0 = install once only.
HERMES_PROFILE_AUTO_UPDATE=0

# ---------------------------------------------------------------------------
# jev first-boot init (017-jev-skills, 019-jev-init)
# ---------------------------------------------------------------------------
# Jev API key. Routing is enabled only once a key is present (jev doctor passes).
#
# This key is for JEV ITSELF — the classifier that answers "how hard is this
# turn?". It is NOT the key for the models jev routes TO; those are your normal
# provider keys and the pools in <profile>/jev/routing.json.
TYPESAFE_API_KEY=
# Serving jev's decision calls from OpenRouter instead of TypeSafe takes BOTH of
# these — a bare OPENROUTER_API_KEY in the environment is deliberately ignored
# ("an existing install never starts routing its decisions somewhere else
# because an OpenRouter or Zen key happened to be in the environment"):
#   1. store the key:  docker compose exec hermes /opt/data/bin/jev setup-key --provider openrouter
#   2. set this:       JEV_PROVIDER=openrouter
# Valid: empty (typesafe) | openrouter | venice | zen. Honored only when that
# provider has a stored key. Verify with `jev doctor` -> key.provider.
JEV_PROVIDER=
# Every jev toggle defaults to OFF. A fresh profile can have validated pools AND
# a working key and still route nothing, because routing is opt-in — it took an
# explicit `/jev routing on` + `/jev skills on` in a chat session. 019-jev-init
# now writes both on first boot so that is not a manual step.
#
# Written regardless of whether a key is present yet: jev fails open ("No key,
# timeout, rate limit, malformed reply, low confidence: routing keeps your
# current model ... skill selection suggests nothing"), so `on` with no key is a
# no-op that goes live the moment `jev setup-key` stores one — no restart.
#
# A value already in <profile>/jev/state.json is never overridden, so an
# operator's `/jev routing shadow` survives every later boot.
#
# on | shadow | off. shadow logs routing decisions without switching models.
JEV_ROUTING_MODE=on
# on | off — jev-driven skill selection (`/jev skills`). No shadow rung.
JEV_SKILLS_MODE=on
# Cold-start fallback routing.json, from a mounted host file (in-container path,
# e.g. /opt/routing.json) instead of the default baked at docker/defaults/jev/.
# Used only when the profile has no routing.json AND no jev key is available —
# Takes precedence over the baked default. `jev models suggest --write` is the
# fallback for when neither exists. Never overwrites a <profile>/jev/routing.json
# authored in the volume.
JEV_ROUTING_FILE=
# 0 = the curated pools win. They are validated against the live catalog:
# monotonic price per specialty (simple <= medium <= hard), no dead specialty
# cells, no blind model in a vision pool.
# 1 = let `jev models suggest --write` choose from the catalog instead. Cheaper
# on paper, but it optimises for price alone — it has no idea that vision turns
# here are ERPNext document extraction, or that `hard` should lead a frontier
# model. Re-validate with `jev doctor` either way.
#
# Whatever the source: a stale pool file silently inverts. The shipped default
# used to lead `hard` with an `anthropic:` prefix that does not exist in the
# OpenRouter catalog (the models are there as `openrouter:anthropic/claude-*`),
# so every hard pool fell through to a $0.11 model and `jev doctor` reported
# price_order: inverted — routing *down* to medium cost 25x more than hard.
JEV_ROUTING_PREFER_SUGGEST=0
# Space-separated profiles to initialise ("default" = root home).
# Empty = the profile installed by 016.
JEV_INIT_PROFILES=
# 0 = skip jev init entirely
JEV_INIT_ENABLE=1

# ---------------------------------------------------------------------------
# Gateway promotion, first boot only (0195-gateway-state)
# Marks the custom profile's gateway_state.json desired_state=running and
# default's desired_state=stopped, so 02-reconcile-profiles (which creates
# the s6 slots) starts the custom profile instead of default. Runs once
# (marker in the profile dir); later boots / manual `hermes gateway
# start|stop` are left alone.
# ---------------------------------------------------------------------------
# 0 = skip; default stays running, the custom profile stays stopped
GATEWAY_PROMOTE_ENABLE=1
# Profile to promote. Empty = the profile installed by 016-profile-install.
GATEWAY_PROMOTE_PROFILE=

# ---------------------------------------------------------------------------
# hermes-lcm (018-hermes-lcm)
# ---------------------------------------------------------------------------
# 0 = do not enable the plugin / set context.engine=lcm
HERMES_LCM_ENABLE=1
# 1 = register the /lcm slash command (/lcm doctor, /lcm doctor repair apply,
# /lcm backup). The plugin defaults it off; without it you get
# "Unknown command: /lcm".
LCM_ENABLE_SLASH_COMMAND=1

# ---------------------------------------------------------------------------
# Not forwarded by docker-compose.yaml by default. To use these, add them to
# the `environment:` list there (the commented examples), or put them in the
# profile's own .env inside the volume instead.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# TELEGRAM_BOT_TOKEN=
