# Copy to .env (git-ignored) and edit:  cp env.example .env
# docker compose reads .env automatically. Values shown are the defaults used
# by docker-compose.yaml when a variable is unset/empty.

# ---------------------------------------------------------------------------
# Build args (image build only: `docker compose build`)
# Pin to a tag or commit SHA for reproducible images.
# ---------------------------------------------------------------------------
# hermes-jev-skills ref
JEV_REF=main
# hermes-lcm ref
LCM_REF=main

# ---------------------------------------------------------------------------
# Container name. Precedence: HERMES_CONTAINER_NAME, else HERMES_PROFILE_NAME
# (below), else COMPOSE_PROJECT_NAME (compose's own default: this folder's
# name, lowercased/sanitized). Leave both empty to just get the folder name.
# ---------------------------------------------------------------------------
HERMES_CONTAINER_NAME=

# ---------------------------------------------------------------------------
# Hermes
# ---------------------------------------------------------------------------
# Enable the Hermes web dashboard (published on host port 9111)
HERMES_DASHBOARD=1

# ---------------------------------------------------------------------------
# Profile install on first boot (016-profile-install)
# Source, first match wins:
#   1. HERMES_PROFILE_LOCAL_PATH  (mounted local clone)
#   2. HERMES_PROFILE_SOURCE      (git URL; set to empty to skip the install)
# ---------------------------------------------------------------------------
# Profile name. Empty = last segment of the source (erpmate for the URL below).
HERMES_PROFILE_NAME=
HERMES_PROFILE_SOURCE=https://github.com/qkeee-ai/erpmate.git

# Local clone mode: in-container path of a mounted clone containing
# distribution.yaml, e.g. /opt/erpmate. Also uncomment the matching volume in
# docker-compose.yaml (./:/opt/erpmate:ro).
HERMES_PROFILE_LOCAL_PATH=

# Private repo auth (HTTPS token or SSH key; leave empty for a public repo).
# Token: needs read access to the repo (GitHub PAT / app token).
HERMES_PROFILE_GIT_TOKEN=
# Alternative: path to a file holding the token (e.g. a docker secret).
HERMES_PROFILE_GIT_TOKEN_FILE=
# For git@host:org/repo sources: path to a mounted private key.
HERMES_PROFILE_SSH_KEY_FILE=

# 1 = run `hermes profile update` on every boot (user data is preserved,
# distribution-owned files are overwritten). 0 = install once only.
HERMES_PROFILE_AUTO_UPDATE=0

# ---------------------------------------------------------------------------
# jev first-boot init (017-jev-skills, 019-jev-init)
# ---------------------------------------------------------------------------
# Jev API key. Routing is enabled only once this is present (jev doctor passes).
TYPESAFE_API_KEY=
# on | shadow | off. shadow logs routing decisions without switching models.
JEV_ROUTING_MODE=on
# Seed routing.json from a mounted host file (in-container path, e.g.
# /opt/routing.json) instead of the default baked at docker/defaults/jev/.
# Never overwrites an existing <profile>/jev/routing.json.
JEV_ROUTING_FILE=
# Space-separated profiles to initialise ("default" = root home).
# Empty = the profile installed by 016.
JEV_INIT_PROFILES=
# 0 = skip jev init entirely
JEV_INIT_ENABLE=1

# ---------------------------------------------------------------------------
# Gateway promotion, first boot only (0195-gateway-state)
# Marks the custom profile's gateway_state.json desired_state=running and
# default's desired_state=stopped, so 02-reconcile-profiles (which creates
# the s6 slots) starts the custom profile instead of default. Runs once
# (marker in the profile dir); later boots / manual `hermes gateway
# start|stop` are left alone.
# ---------------------------------------------------------------------------
# 0 = skip; default stays running, the custom profile stays stopped
GATEWAY_PROMOTE_ENABLE=1
# Profile to promote. Empty = the profile installed by 016-profile-install.
GATEWAY_PROMOTE_PROFILE=

# ---------------------------------------------------------------------------
# hermes-lcm (018-hermes-lcm)
# ---------------------------------------------------------------------------
# 0 = do not enable the plugin / set context.engine=lcm
HERMES_LCM_ENABLE=1

# ---------------------------------------------------------------------------
# Not forwarded by docker-compose.yaml by default. To use these, add them to
# the `environment:` list there (the commented examples), or put them in the
# profile's own .env inside the volume instead.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
# HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
# TELEGRAM_BOT_TOKEN=
